<h2>Add Match</h2>

<form action="/add-match" method="POST">
  <input type="text" name="player" placeholder="Player" required>
  <input type="text" name="opponent" placeholder="Opponent" required>
  <input type="text" name="score" placeholder="Score (ex: 6-4)">
  
  <button type="submit">Add Match</button>
</form>

